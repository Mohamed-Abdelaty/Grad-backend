{
  "pipeline": {
    "id": "11111111-1111-4111-8111-111111111111",
    "name": "orders-pipeline",
    "version": 1,
    "schedule": null,
    "nodes": [
      {
        "id": "src_1",
        "type": "source",
        "plugin": "csv",
        "config": {"path": "examples/data/orders.csv", "delimiter": ","}
      },
      {
        "id": "tr_1",
        "type": "transform",
        "plugin": "filter",
        "config": {"expression": "amount > 100"}
      },
      {
        "id": "snk_1",
        "type": "sink",
        "plugin": "csv",
        "config": {"path": "outputs/orders_clean.csv", "mode": "overwrite"}
      }
    ],
    "edges": [
      {"from": "src_1", "to": "tr_1"},
      {"from": "tr_1", "to": "snk_1"}
    ],
    "retry": {"max_attempts": 3, "backoff_seconds": 5}
  }
}
