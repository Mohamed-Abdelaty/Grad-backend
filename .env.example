# --- Database ---
# Production PostgreSQL DSN. Engine Postgres plugins read their DSN from
# plugin config `dsn_env` (name of the env var) or `dsn` directly; never commit real secrets.
DATABASE_URL=postgresql+psycopg://chaosflow:chaosflow@localhost:5432/chaosflow
# For local dev without Postgres, the app falls back to SQLite when DATABASE_URL is unset:
# (sqlite:///./chaosflow.db)

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- API ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --- Engine ---
ENGINE_BATCH_SIZE=500
ENGINE_MAX_BACKOFF_SECONDS=60
