# --- Database ---
# Production PostgreSQL DSN. Engine Postgres plugins read their DSN from
# plugin config `dsn_env` (name of the env var) or `dsn` directly; never commit real secrets.
DATABASE_URL=postgresql+psycopg://chaosflow:chaosflow@localhost:5432/chaosflow
# For local dev without Postgres, the app falls back to SQLite when DATABASE_URL is unset:
# (sqlite:///./chaosflow.db)

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- API ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --- Engine ---
ENGINE_BATCH_SIZE=500
ENGINE_MAX_BACKOFF_SECONDS=60
RUN_WORKER_THREADS=4

# --- Admin Seeding ---
ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=123456

# --- Scheduler ---
SCHEDULER_ENABLED=true
SCHEDULER_MAX_INSTANCES=1
SCHEDULER_MISFIRE_GRACE_TIME=60
SCHEDULER_ADVISORY_LOCK_ID=123456789

# --- API Keys ---
API_KEY_DEFAULT_EXPIRY_DAYS=90

# --- Audit Log ---
AUDIT_LOG_RETENTION_DAYS=365

# --- Notifications (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
SMTP_TIMEOUT=10

# --- Notifications (Webhook) ---
WEBHOOK_MAX_RETRIES=3
WEBHOOK_TIMEOUT=5
WEBHOOK_BACKOFF_BASE=2.0
WEBHOOK_ALLOW_PRIVATE_IPS=false

# --- Notifications (Encryption) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- SSRF Protection ---
SSRF_ALLOW_PRIVATE_IPS=false